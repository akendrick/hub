# knotwork.ca — .htaccess
# Rename to .htaccess and place in the web root.

# ── Pass Authorization header through to PHP (required on Apache + PHP-FPM) ──
# Apache strips HTTP_AUTHORIZATION before PHP sees it unless this rule is present.
# Without it, Bearer token auth silently fails for every device-api.php request.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},L]
</IfModule>

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# ── Protect sensitive data files ──────────────────────────────────────────────
<FilesMatch "^(api-keys\.json|todo\.json|.*\.json\.tmp\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
